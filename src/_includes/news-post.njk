---
layout: layout.njk
---
<article class="wrap post">
  <p class="post-back"><a href="/news.html">&larr; Back to News</a></p>

  <h1>{{ title }}</h1>
  <p class="post-meta">{{ date | readableDate }}</p>

  {% if image %}
  <img src="{{ image }}" alt="{{ title }}" style="width: 100%; max-width: 600px; height: auto; object-fit: contain; margin: 20px auto; display: block; border-radius: 8px;">
  {% endif %}

  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
