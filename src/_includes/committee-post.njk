---
layout: layout.njk
---
<article class="wrap post">
  <p class="post-back"><a href="/committees.html">&larr; Back to Committees</a></p>
  <h1>{{ title }}</h1>
  {% if image %}
  <img class="post-hero" src="{{ image }}" alt="{{ title }}">
  {% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
  {% if volunteers %}
  <section class="honor-roll">
    <p class="eyebrow">Honor Roll</p>
    <h2>Volunteers of the Year</h2>
    <p class="honor-roll-intro">At IAEG Peru, our impact is driven by the dedication of our community. We celebrate the exceptional contributions of active members across all career stages.</p>
    {% set sortedVolunteers = volunteers | sort(true, false, "year") %}
    {% set lastYear = "" %}
    {% for v in sortedVolunteers %}
      {% if v.year != lastYear %}
        {% if not loop.first %}</div></div>{% endif %}
        <div class="honor-year">
          <p class="honor-year-label">🏅 {{ v.year }} Honorees</p>
          <div class="honor-grid">
          {% set lastYear = v.year %}
      {% endif %}
          <div class="honoree-card">
            {% if v.photo %}
            <img class="honoree-photo" src="{{ v.photo }}" alt="{{ v.name }}">
            {% else %}
            <div class="honoree-photo honoree-photo-placeholder">🏅</div>
            {% endif %}
            <strong class="honoree-name">{{ v.name }}</strong>
            {% if v.role %}<p class="honoree-role">{{ v.role }}</p>{% endif %}
            {% if v.description %}<p class="honoree-desc">{{ v.description }}</p>{% endif %}
            {% if v.linkedin %}<a class="honoree-linkedin" href="{{ v.linkedin }}" target="_blank" rel="noopener">🔗 LinkedIn</a>{% endif %}
          </div>
      {% if loop.last %}</div></div>{% endif %}
    {% endfor %}
  </section>
  {% endif %}
</article>
