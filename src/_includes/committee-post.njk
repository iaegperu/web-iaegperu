---
layout: layout.njk
---
<article class="wrap post">
  <p class="post-back"><a href="/committees.html">&larr; Back to Committees</a></p>
  <h1>{{ title }}</h1>
  {% if image %}
  <img class="post-hero" src="{{ image }}" alt="{{ title }}">
  {% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>

{% if workLines and workLines.length %}
<section>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Focus</p>
      <h2>Lines of Work</h2>
    </div>
    <div class="grid cols-3">
      {% for wl in workLines %}
      <div class="card">
        <div class="body">
          <h3>{{ wl.title }}</h3>
          {% if wl.description %}<div>{{ wl.description | markdownify | safe }}</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if activities and activities.length %}
<section class="alt">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">In progress</p>
      <h2>Activities</h2>
    </div>
    <div class="grid cols-3">
      {% for a in activities %}
      <div class="card">
        <div class="body">
          {% if a.status %}<div class="meta">{{ a.status }}{% if a.date %} &middot; {{ a.date }}{% endif %}</div>{% endif %}
          <h3>{{ a.title }}</h3>
          {% if a.description %}<p>{{ a.description }}</p>{% endif %}
          {% if a.buttonUrl and a.buttonLabel %}<a href="{{ a.buttonUrl }}" target="_blank" rel="noopener">{{ a.buttonLabel }} &rarr;</a>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if members and members.length %}
<section>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">People</p>
      <h2>Committee Members</h2>
    </div>
    <div class="grid cols-3">
      {% for m in members %}
      <div class="card">
        {% if m.photo %}<img src="{{ m.photo }}" alt="{{ m.name }}">{% endif %}
        <div class="body">
          <h3>{{ m.name }}</h3>
          {% if m.role %}<div class="meta">{{ m.role }}</div>{% endif %}
          {% if m.bio %}<p>{{ m.bio }}</p>{% endif %}
          {% if m.url %}<a href="{{ m.url }}" target="_blank" rel="noopener">Profile &rarr;</a>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

